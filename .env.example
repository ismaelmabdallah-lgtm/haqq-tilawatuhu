# Public — safe in the browser; every query is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_FILES_BASE_URL=https://files.example.pages.dev   # public R2 bucket URL

# Build/CI only — never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=        # used only by the keep-alive/backup workflow
