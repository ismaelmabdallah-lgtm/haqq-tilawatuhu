{
  "name": "haqq-tilawatuhu",
  "private": true,
  "version": "0.2.0",
  "description": "حَقَّ تِلَاوَتِهِ — منصة مجانية مفتوحة لتعليم أحكام التلاوة والتجويد",
  "type": "module",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "quran:setup": "node scripts/quran-setup.mjs",
    "predev": "node scripts/quran-setup.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/quran-setup.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild-flatten-segments.mjs",
    "preview": "wrangler pages dev out",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test:db:pglite": "node scripts/test-db-pglite.mjs",
    "test:seed:generate": "node tests/fixtures/make-test-seed.mjs",
    "curriculum:map": "python3 scripts/build_curriculum_map.py",
    "curriculum:seed": "python3 scripts/generate_seed.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.168.0"
  }
}
